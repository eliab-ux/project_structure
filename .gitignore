# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml
# package-lock.json IS versioned — required by `npm ci` no build Docker (deploy reprodutível).

# Build output
dist/
build/
*.tsbuildinfo
# Next.js: saída de build. Sem esta linha, 128 arquivos gerados entravam no commit do Veertex.
# `next-env.d.ts` fica VERSIONADO de propósito, ao contrário do template do create-next-app:
# `npm run typecheck` num clone novo roda antes de qualquer `next build`, e sem o arquivo o tsc
# perderia as declarações de tipo do Next.
.next/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
# Arquivo lixo de nome reservado do Windows (criado por engano)
/nul

