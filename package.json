{
  "name": "@gitspread/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo com arquitetura hexagonal usando NestJS + MikroORM",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/kaza-tem-system/backend",
    "apps/kaza-tem-system/frontend",
    "apps/ecoa-system/backend",
    "apps/ecoa-system/frontend",
    "apps/emdrremoto/backend",
    "apps/emdrremoto/frontend",
    "apps/plano-diario/backend",
    "apps/plano-diario/frontend",
    "apps/batuta-system/backend",
    "apps/batuta-system/frontend",
    "apps/Veertex/packages/*",
    "apps/Veertex/backend",
    "apps/Veertex/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:e2e": "jest --testPathPattern=test/e2e",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"{packages,apps}/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:packages": "tsc --noEmit --project tsconfig.json"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
