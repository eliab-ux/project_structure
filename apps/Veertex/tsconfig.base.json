{
  "//": "Opções compartilhadas por TODOS os workspaces. Este arquivo NÃO compila nada — não tem `include`. Cada app/package define o próprio `include`/`exclude` e sobrescreve o que a sua stack exige (um frontend Next precisa de `jsx` e `lib: dom`, um backend Nest não).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "composite": true,
    "incremental": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "baseUrl": "./",
    "paths": {
      "@veertex/domain-primitives": ["packages/domain-primitives/src"],
      "@veertex/shared-kernel": ["packages/shared-kernel/src"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
