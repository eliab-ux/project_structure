# ==== Aplicação ====
VEERTEX_APP_NAME=Veertex
NODE_ENV=development
PORT=3020
HOST=0.0.0.0

# ══════════════════════════════════════════════════════════════════════════════════════════════
# ARQUIVOS DE AMBIENTE E PRECEDÊNCIA
#
#   .env.local   → desenvolvimento. GITIGNORED. Aponta para o Postgres local (127.0.0.1:5433).
#   .env         → referência/deploy fora do Dokploy. Também gitignored.
#
# `.env.local` GANHA de `.env` (ver src/config/load-env.ts). Variável já exportada no shell — ou
# injetada pelo Dokploy — ganha dos dois. Em produção não existe arquivo nenhum.
#
# Este `.env.example` é o único versionado, e não contém valor real.
# ══════════════════════════════════════════════════════════════════════════════════════════════

# ==== Banco ====
# DUAS connection strings, de propósito (ver deploy/sql/001_create_roles.sql):
#
#   DATABASE_URL            → veertex_app    — usuário de RUNTIME. Sem DDL, sem DELETE/TRUNCATE,
#                                              sujeito a RLS. É com ele que a API atende requisição
#                                              e é com ele que os testes de isolamento rodam.
#   DATABASE_URL_MIGRATIONS → veertex_owner  — dono do schema. Migrations, CLIs de operador e as
#                                              fixtures dos testes. NUNCA para servir tráfego.
#
# As duas apontando para o MESMO usuário fazem a verificação passar com o RLS desligado — o dono
# ignora as policies. O runner e o `verify:isolation` abortam nesse caso.
#
# ── DESENVOLVIMENTO (no .env.local, Postgres do docker-compose.dev.yml) ──────────────────────
# DATABASE_URL=postgresql://veertex_app:SENHA_APP@127.0.0.1:5433/veertex
# DATABASE_URL_MIGRATIONS=postgresql://veertex_owner:SENHA_OWNER@127.0.0.1:5433/veertex

#
# 5433 e não 5432: evita colidir com um Postgres já instalado na máquina, e um erro de porta que
# apontasse para o banco errado seria descoberto tarde.
#
# ---- Banco de TESTE (obrigatório para rodar a suíte) ----
# A suíte APAGA CONTAS por desenho — é o que dá sentido aos testes de isolamento entre tenants.
# Enquanto dev e teste compartilhavam o banco, `npx jest` destruía os dados de quem estivesse com a
# aplicação aberta. O test/setup-env.ts ABORTA se estas faltarem, se forem iguais às de cima, ou se
# o nome do banco não contiver "test".
# Provisione com o MESMO script de produção (README.md): -v db_name=veertex_test
DATABASE_URL_TEST=postgresql://veertex_app:<senha>@127.0.0.1:5433/veertex_test
DATABASE_URL_MIGRATIONS_TEST=postgresql://veertex_owner:<senha>@127.0.0.1:5433/veertex_test

# ── PRODUÇÃO (aba Environment do Dokploy, host INTERNO do Docker) ────────────────────────────
DATABASE_URL=postgresql://veertex_app:CHANGE_ME@veertex-veertex-eeilbu:5432/veertex
DATABASE_URL_MIGRATIONS=postgresql://veertex_owner:CHANGE_ME@veertex-veertex-eeilbu:5432/veertex
# Senha com caractere especial → URL-encode (`@` vira `%40`, `#` vira `%23`, etc.).

# Nomes dos dois papéis, usados pelo bootstrap e por `npm run verify:isolation`.
# Só mexa aqui se tiver renomeado os papéis no 001_create_roles.sql — os padrões abaixo são os dele.
DATABASE_OWNER_ROLE=veertex_owner
DATABASE_APP_ROLE=veertex_app

# ==== Bootstrap do banco (no start da aplicação) ====
# A cada boot o backend faz, sob advisory lock (seguro com várias réplicas):
#   1. aplica migrations pendentes        (só se AUTO_MIGRATE ≠ false)
#   2. VERIFICA os invariantes de isolamento — falhou, o processo aborta e não atende requisição
#   3. reconcilia o catálogo de planos    (idempotente; nunca sobrescreve plano existente)
#
# `false` desliga apenas o passo 1, para deploy controlado em que as migrations são aplicadas fora
# de banda. O passo 2 roda SEMPRE — subir sem isolamento verificado nunca é aceitável.
#
# ⚠️ Com AUTO_MIGRATE ligado, este processo precisa de DATABASE_URL_MIGRATIONS, ou seja, guarda uma
#    credencial capaz de DDL. É uma redução real do que o desenho de dois papéis oferece — decisão
#    consciente em troca de operação sem passo manual. A variável é apagada de process.env logo
#    após o bootstrap.
AUTO_MIGRATE=true

# ==== Auth (JWT próprio — sem provedor de identidade externo) ====
JWT_ACCESS_SECRET=change-me-strong-random-access-secret
JWT_REFRESH_SECRET=change-me-strong-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==== Reset de senha ====
# Não há variável de TTL: a recuperação é um código de 6 dígitos no WhatsApp com validade de 15
# minutos definida em RESET_CODE_TTL_MINUTES (entidade de domínio) — é regra de negócio, não
# configuração de ambiente. O canal é a instância de SISTEMA do Evolution, abaixo.

# ==== Evolution API (WhatsApp — código de recuperação de senha) ====
EVOLUTION_API_URL=https://evo2.techbs.com.br
# Instância de SISTEMA da plataforma. Nunca um chip de cliente/tenant: chip de campanha cai, e o
# canal de recuperação de senha não pode cair junto.
EVOLUTION_SYSTEM_INSTANCE=
# Apikey DA INSTÂNCIA (menor privilégio) — nunca a chave global do servidor Evolution: enviar
# mensagem não precisa de poder para criar ou apagar instância.
EVOLUTION_SYSTEM_APIKEY=

# ==== Web ====
# Em produção liste as origens reais, separadas por vírgula. Nunca '*' com credentials.
CORS_ORIGIN=http://localhost:3021
FRONTEND_URL=http://localhost:3021

# ==== Error reporter (VEXGuard — ainda não existe; vazio = adapter no-op) ====
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=

# ==== Comandos de operador (não são configuração da aplicação) ====
# As três variáveis abaixo são lidas por CLIs, não pelo servidor. Ficam aqui porque toda variável
# de ambiente deste projeto é documentada no .env.example (CLAUDE.md, regra 5) — não porque o
# backend precise delas para subir. Deixe-as vazias no ambiente de execução da API.

# Senha do admin em `npm run create:account`. Vem por ambiente, e não por --admin-password, porque
# argumento de linha de comando aparece no `ps`, no histórico do shell e no eco do próprio
# `npm run` — foi assim que uma senha foi parar no scrollback na primeira execução real do comando.
VEERTEX_ADMIN_PASSWORD=

# Credenciais de uma conta JÁ EXISTENTE, usadas por `npm run smoke:auth` para exercitar o login
# ponta a ponta. O smoke é somente leitura e NÃO cria conta — rode create:account antes.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# ==== Proteção do login contra força bruta ====
# Duas camadas (ver ADR-0004 e o port LoginThrottlePort). Os padrões abaixo valem se as variáveis
# estiverem ausentes; em desenvolvimento e nos testes elas são reduzidas para não tornar a suíte
# lenta.
#
# Camada 1 — teto de FALHAS por IP dentro da janela. Depois dele, 429. Generoso de propósito: num
# varejo, todos os PDVs de uma loja saem pelo mesmo IP público, e um teto apertado tiraria a loja do
# ar por causa de operadores digitando senha errada.
LOGIN_IP_FAILURE_LIMIT=50
LOGIN_IP_WINDOW_MS=300000
#
# Camada 2 — atraso progressivo por credencial: 1s, 2s, 4s, 8s, com teto. ATRASO, nunca bloqueio:
# bloquear a conta permitiria trancar um operador sabendo só o e-mail dele.
LOGIN_DELAY_BASE_MS=1000
LOGIN_DELAY_MAX_MS=8000
# Silêncio após o qual a escada da credencial recomeça do zero.
LOGIN_DELAY_RESET_MS=900000

# ==== Tradução de intenção (a Mesa) ====
# Qual adapter traduz texto em comando. Ver contexts/intent/intent.module.ts.
#
#   (vazio ou qualquer valor)  → Gemini por HTTP. É o PADRÃO de propósito: ambiente sem chave FALHA
#                                visivelmente, em vez de parecer funcionar devolvendo comando
#                                enlatado por palavra-chave e chamando isso de tradução.
#   deterministic              → tradutor por palavra-chave. Opt-in EXPLÍCITO, para teste e para
#                                desenvolvimento sem chave. Nunca use em produção.
INTENT_PARSER_DRIVER=

# Gemini por HTTP puro, sem SDK (adapter sem SDK é mais fácil de trocar — é o ponto do port).
# A chave vai no header x-goog-api-key, nunca na query string: URL aparece em log de proxy.
#
# URL e MODELO têm padrão no código (v1beta / gemini-2.5-flash) e podem ficar vazios aqui.
# A CHAVE não tem padrão: sem ela o canal não sobe, e é isso que o ensureAvailable() detecta.
# gemini-2.5-flash é o modelo atual do free tier — o 2.0-flash foi descontinuado.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==== Ditado por voz (captura no navegador, transcrição no Gemini) ====
# `true` liga o microfone nas telas; qualquer outro valor (ou ausência) o faz NÃO APARECER — não é
# botão desabilitado, é ausência.
#
# ⚠️ NASCE DESLIGADO, e não é preferência de rollout: enquanto a GEMINI_API_KEY for de free tier, o
# conteúdo enviado pode ser lido por revisor humano e usado para treino (DEPENDENCIAS_EXTERNAS §5).
# Áudio de comando carrega nome de pessoa e de empresa — ele não sai por esse canal. Ligue isto
# JUNTO com a chave própria com billing ativo, nunca antes.
AUDIO_TRANSCRIPTION_ENABLED=false

# MinIO (storage de evidencias da rota - fotos; chave persistida, URL montada na leitura)
# Ausente MINIO_ENDPOINT -> adapter no-op (dev sem servidor). Valores reais so no .env/Dokploy.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
MINIO_BUCKET=veertex-evidence

# COB (06): cifra das credenciais do agregador de cobranca (aes-256-gcm). 64 hex = 32 bytes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BILLING_CREDENTIALS_KEY=
