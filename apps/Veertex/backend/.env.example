# ==== Aplicação ====
VEERTEX_APP_NAME=Veertex
NODE_ENV=development
PORT=3020
HOST=0.0.0.0

# ==== Banco (PostgreSQL self-hosted no mdantas) ====
# DUAS connection strings, de propósito (ver deploy/sql/001_create_roles.sql):
#
#   DATABASE_URL            → veertex_app    — usuário de RUNTIME. Sem DDL, sem TRUNCATE, sujeito a
#                                              RLS. É com ele que a API atende requisição.
#   DATABASE_URL_MIGRATIONS → veertex_owner  — dono do schema. Roda migrations e o CLI create:account.
#                                              NUNCA usar para servir tráfego.
#
# Os valores reais só existem no .env local ou na aba Environment do Dokploy — nunca versionados.
DATABASE_URL=postgresql://veertex_app:CHANGE_ME@localhost:5432/veertex
DATABASE_URL_MIGRATIONS=postgresql://veertex_owner:CHANGE_ME@localhost:5432/veertex

# Nomes dos dois papéis, usados pelo bootstrap e por `npm run verify:isolation`.
# Só mexa aqui se tiver renomeado os papéis no 001_create_roles.sql — os padrões abaixo são os dele.
DATABASE_OWNER_ROLE=veertex_owner
DATABASE_APP_ROLE=veertex_app

# ==== Bootstrap do banco (no start da aplicação) ====
# A cada boot o backend faz, sob advisory lock (seguro com várias réplicas):
#   1. aplica migrations pendentes        (só se AUTO_MIGRATE ≠ false)
#   2. VERIFICA os invariantes de isolamento — falhou, o processo aborta e não atende requisição
#   3. reconcilia o catálogo de planos    (idempotente; nunca sobrescreve plano existente)
#
# `false` desliga apenas o passo 1, para deploy controlado em que as migrations são aplicadas fora
# de banda. O passo 2 roda SEMPRE — subir sem isolamento verificado nunca é aceitável.
#
# ⚠️ Com AUTO_MIGRATE ligado, este processo precisa de DATABASE_URL_MIGRATIONS, ou seja, guarda uma
#    credencial capaz de DDL. É uma redução real do que o desenho de dois papéis oferece — decisão
#    consciente em troca de operação sem passo manual. A variável é apagada de process.env logo
#    após o bootstrap.
AUTO_MIGRATE=true

# ==== Auth (JWT próprio — sem provedor de identidade externo) ====
JWT_ACCESS_SECRET=change-me-strong-random-access-secret
JWT_REFRESH_SECRET=change-me-strong-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==== Reset de senha ====
# Não há variável de TTL: a recuperação é um código de 6 dígitos no WhatsApp com validade de 15
# minutos definida em RESET_CODE_TTL_MINUTES (entidade de domínio) — é regra de negócio, não
# configuração de ambiente. O canal é a instância de SISTEMA do Evolution, abaixo.

# ==== Evolution API (WhatsApp — código de recuperação de senha) ====
EVOLUTION_API_URL=https://evo2.techbs.com.br
# Instância de SISTEMA da plataforma. Nunca um chip de cliente/tenant: chip de campanha cai, e o
# canal de recuperação de senha não pode cair junto.
EVOLUTION_SYSTEM_INSTANCE=
# Apikey DA INSTÂNCIA (menor privilégio) — nunca a chave global do servidor Evolution: enviar
# mensagem não precisa de poder para criar ou apagar instância.
EVOLUTION_SYSTEM_APIKEY=

# ==== Web ====
# Em produção liste as origens reais, separadas por vírgula. Nunca '*' com credentials.
CORS_ORIGIN=http://localhost:3021
FRONTEND_URL=http://localhost:3021

# ==== Error reporter (VEXGuard — ainda não existe; vazio = adapter no-op) ====
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=
