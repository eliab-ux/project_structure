{
  "name": "@veertex/root",
  "version": "1.0.0",
  "private": true,
  "description": "Veertex — ERP SaaS multi-tenant (arquitetura hexagonal, NestJS + Next.js)",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"{packages,backend,frontend}/**/*.{ts,tsx}\"",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose -f backend/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f backend/docker-compose.dev.yml down",
    "verify": "npm run verify:isolation -w @veertex/backend"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
