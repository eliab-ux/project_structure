# ============================================================================
# ECOA — variáveis de PRODUÇÃO (colar na aba "Environment" do serviço BACKEND no Dokploy)
# Ajuste os domínios conforme os subdomínios definidos no Dokploy/Traefik.
# ============================================================================

APP_NAME=Ecoa
NODE_ENV=production
PORT=3005
HOST=0.0.0.0

# ---- Banco (Supabase — Session Pooler / IPv4, mesmo de dev) ----
DATABASE_URL=postgresql://postgres.jlroiomaceuopbocwhpa:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- Supabase API/Storage (só se usar buckets) ----
SUPABASE_URL=https://jlroiomaceuopbocwhpa.supabase.co
SUPABASE_SECRET_KEY=

# ---- Redis (serviço Redis do Dokploy — use o HOST INTERNO que o Dokploy mostrar) ----
# Ex.: o Dokploy dá um hostname interno tipo "ecoa-redis" na rede dokploy-network.
REDIS_HOST=ecoa-redis
REDIS_PORT=6379
# Se o Redis do Dokploy exigir senha, me avise que eu adiciono suporte a REDIS_PASSWORD no app.

# ---- Auth (JWT próprio) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- Meta / Instagram (URLs agora PÚBLICAS!) ----
META_APP_ID=2047002089570738
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://ecoa.mdantas.com.br/connection/callback
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# ---- Cripto do token do IG (32 bytes hex = 64 chars) — MESMA chave de dev, senão não decripta ----
IG_TOKEN_ENCRYPTION_KEY=

# ---- SMTP (reset de senha) ----
SMTP_HOST=mail.mdantas.com.br
SMTP_PORT=465
SMTP_USER=suporte@equipamentospsi.com
SMTP_PASSWORD=
SMTP_FROM=suporte@equipamentospsi.com

# ---- CORS + Frontend (domínio público do frontend) ----
CORS_ORIGIN=https://ecoa.mdantas.com.br
FRONTEND_URL=https://ecoa.mdantas.com.br

# ---- Error reporter (vazio = no-op) ----
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=

# ============================================================================
# FRONTEND (serviço separado no Dokploy) — NÃO é env de runtime, é BUILD ARG:
#   NEXT_PUBLIC_API_URL = https://api-ecoa.mdantas.com.br/api
# (NEXT_PUBLIC_* é embutido no build do Next — configure em "Build Args" do serviço frontend.)
# ============================================================================
