# ==== Aplicação ====
BATUTA_APP_NAME=Batuta
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# ==== Banco (PostgreSQL self-hosted no mdantas) — usado pelo MikroORM ====
# Dimensione max_connections somando API + workers (pool da API é min 0 / max 5).
DATABASE_URL=postgresql://user:pass@host:5432/batuta

# ==== Redis (BullMQ) ====
# Em produção (Dokploy): REDIS_HOST = Internal Host gerado pelo Dokploy, não o nome amigável.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# ==== Auth (JWT próprio) ====
JWT_ACCESS_SECRET=change-me-strong-random-access-secret
JWT_REFRESH_SECRET=change-me-strong-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==== Aprovação por magic link ====
APPROVAL_TOKEN_TTL_HOURS=72

# ==== Reset de senha ====
# Não há variável: a recuperação é um código de 6 dígitos enviado no WhatsApp, com validade de
# 15 minutos definida em RESET_CODE_TTL_MINUTES (entidade de domínio) — é regra de negócio, não
# configuração de ambiente. O canal é a instância de sistema do Evolution, abaixo.

# ==== Evolution API (WhatsApp) ====
# Valores REAIS só no .env local ou na aba Environment do Dokploy — nunca versionados.
EVOLUTION_API_URL=
# Chave GLOBAL do servidor Evolution. Necessária para CRIAR/APAGAR instância (chip de tenant).
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
# Instância de sistema da plataforma: notificação de aprovação, alertas e o CÓDIGO de recuperação
# de senha. NUNCA usar chip de tenant para mensagem de sistema (BATUTA_SPEC §1.7) — chip de
# campanha cai, canal de recuperação não pode cair com ele.
EVOLUTION_SYSTEM_INSTANCE=
# Apikey DA INSTÂNCIA de sistema (não a global). Menor privilégio: enviar mensagem não precisa de
# poder para criar ou apagar instância. Se ficar vazia, o envio usa EVOLUTION_API_KEY e o boot avisa.
EVOLUTION_SYSTEM_APIKEY=
# URL pública deste backend que a Evolution deve chamar (…/api/webhooks/evolution).
EVOLUTION_WEBHOOK_URL=

# ==== MinIO (storage self-hosted) ====
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
# Bucket por conta: {MINIO_BUCKET_PREFIX}{account_id}
MINIO_BUCKET_PREFIX=batuta-

# ==== SMTP (Mailcow — SSL direto na 465) ====
SMTP_HOST=mail.mdantas.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==== Web ====
# Produção: liste as origens reais do frontend (nunca '*' com credentials).
CORS_ORIGIN=http://localhost:3003
FRONTEND_URL=http://localhost:3003

# ==== Error reporter (vazio = no-op) ====
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=

# ==== Throttle adaptativo (BATUTA_SPEC 2.1) ====
# DECISÃO PENDENTE (14, itens 1/2/3): valores provisórios — medir na primeira campanha e calibrar.
CHANNEL_DEFAULT_QUOTA_FLOOR=20
CHANNEL_DEFAULT_QUOTA_CEILING=150
THROTTLE_WINDOW_DAYS=3
THROTTLE_CLEAN_DAYS_FOR_RAISE=3
THROTTLE_RAISE_FACTOR=1.2
THROTTLE_LOWER_FACTOR=0.5
THROTTLE_SEVERE_FAILURE_RATE=0.2
THROTTLE_LOW_DELIVERY_RATE=0.85
THROTTLE_HIGH_OPT_OUT_RATE=0.02
THROTTLE_SEVERE_DISCONNECT_EVENTS=3
# Abaixo deste total de envios na janela, nenhuma taxa é confiável: decisão vira HOLD.
THROTTLE_MIN_SAMPLE=20
# Falhas consecutivas que degradam o canal (circuit breaker, FASE 7).
CHANNEL_CIRCUIT_BREAKER_FAILURES=5

# ==== Timezone padrão da plataforma (usado pelo cron ao fechar o dia) ====
DEFAULT_TIMEZONE=America/Sao_Paulo

# ==== Testes de integração ====
# Banco DESCARTÁVEL: as suítes recriam o schema (refreshDatabase). Nunca aponte para o banco de
# desenvolvimento, e muito menos para produção. O docker-compose local já cria `batuta_test`.
# Ausente → as suítes de integração pulam, e `npm test` roda sem infraestrutura.
TEST_DATABASE_URL=

# ==== Distribuição / agendamento (FASE 6) ====
# DECISÕES PENDENTES §14 itens 4, 5 e 6 — valores abaixo são as sugestões do próprio spec.
DISTRIBUTION_REPLY_RESERVE_PERCENT=20   # item 4: fatia da cota reservada para respostas da caixa
DISPATCH_MIN_INTERVAL_SECONDS=45        # item 5: intervalo mínimo entre envios do mesmo canal
DISPATCH_MAX_INTERVAL_SECONDS=120       # item 5: teto do jitter aleatório
DISPATCH_MAX_PER_HOUR=30                # §9.2 "máximo por hora"; número é de engenharia, não do spec
QUIET_HOURS_START=8                     # item 6: hora local em que o envio pode começar
QUIET_HOURS_END=21                      # item 6: hora local em que o envio para
DEFAULT_TIMEZONE=America/Sao_Paulo      # usado só quando a conta não tem timezone

# ==== Caixa de entrada (FASE 8) ====
INBOX_LOCK_TTL_MINUTES=15          # DECISÃO PENDENTE §14 item 12 (sugestão do spec: 15 min)
INBOX_HISTORY_LIMIT=200            # teto de mensagens devolvidas ao abrir um item
INBOX_MEDIA_URL_TTL_SECONDS=600    # validade da URL assinada de áudio/imagem recebida
