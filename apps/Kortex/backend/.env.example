# ==== Aplicação ====
KORTEX_APP_NAME=Kortex
NODE_ENV=development
PORT=3030
HOST=0.0.0.0

# ==== Banco (PostgreSQL) ====
# Desenvolvimento: container local do apps/Kortex/docker-compose.yml (Postgres 17, porta 55433).
#   docker compose -f apps/Kortex/docker-compose.yml up -d
DATABASE_URL=postgresql://kortex:kortex_local@localhost:55433/kortex
# Produção (mdantas/Dokploy): container PostgreSQL 17 do próprio projeto. O host é o
# **Internal Host** gerado pelo Dokploy, nunca o nome amigável do serviço — é o mesmo erro já
# documentado no playbook do CLAUDE.md com o Redis do Ecoa.
#   DATABASE_URL=postgresql://<user>:<senha>@<internal-host>:5432/kortex
#
# Sem Supabase de propósito: o Kortex não usa RLS (o isolamento multiconta é feito na aplicação,
# regra §0.6 da spec) nem Storage de arquivo (decisão 2.13). Não há o que o Supabase resolveria.

# Banco dos testes de integração — criado pelo deploy/local/init-test-db.sql.
DATABASE_URL_TEST=postgresql://kortex:kortex_local@localhost:55433/kortex_test

# ==== Auth (JWT próprio) ====
# Gerar valores fortes e aleatórios. Nunca reaproveitar o mesmo segredo nos dois.
JWT_ACCESS_SECRET=change-me-strong-random-access-secret
JWT_REFRESH_SECRET=change-me-strong-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==== Recuperação de senha ====
# Não há variável de TTL: a recuperação é um código de 6 dígitos no WhatsApp, válido por 15
# minutos e de uso único. Isso é regra de negócio (CLAUDE.md), não configuração de ambiente — o
# canal é instantâneo e um código que vale uma hora só amplia a janela de quem o interceptou.

# ==== Evolution API (WhatsApp) — canal do código de recuperação ====
# Valores REAIS só no .env local ou na aba Environment do Dokploy — nunca versionados.
EVOLUTION_API_URL=https://evo2.techbs.com.br
# Instância DE SISTEMA (avisos da plataforma). Nunca um chip de cliente: chip de campanha cai, e
# o canal de recuperação de senha não pode cair com ele.
EVOLUTION_SYSTEM_INSTANCE=
# Apikey DA INSTÂNCIA, não a global. Menor privilégio: enviar mensagem não precisa de poder para
# criar ou apagar instância.
EVOLUTION_SYSTEM_APIKEY=

# ==== Web ====
# Produção: liste as origens reais do frontend (nunca '*' com credentials).
CORS_ORIGIN=http://localhost:3031
FRONTEND_URL=http://localhost:3031

# ==== Error reporter (vazio = no-op) ====
# Endpoint de ingestão do VEXGuard, quando existir. Vazio mantém o adapter no-op.
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=
