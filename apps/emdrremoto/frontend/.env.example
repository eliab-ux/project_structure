# API do backend EMDR Remoto (prefixo /api). Exposto ao browser → precisa de NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# WebSocket (Socket.IO) — mesma origem do backend (o IoAdapter sobe na porta do backend).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3005

# Subdomínio do Daily.co (para embutir o vídeo). Ex.: se as salas ficam em
# https://minhaconta.daily.co/<room>, use NEXT_PUBLIC_DAILY_DOMAIN=minhaconta
NEXT_PUBLIC_DAILY_DOMAIN=
