# ==============================================================================
# EMDR Remoto — Backend (referência local; em produção use a UI do Dokploy)
# Nunca commitar valores reais. Copie para .env e preencha.
# ==============================================================================

# --- App ---
NODE_ENV=development
APP_NAME=EMDR Remoto
PORT=3005
HOST=0.0.0.0

# --- CORS (origens do frontend, separadas por vírgula; NUNCA "*" com credenciais) ---
CORS_ORIGIN=http://localhost:3006
# URL pública do frontend para os links enviados (convite). Em produção = domínio real
# (https://...). Necessário para o WhatsApp exibir como link clicável. Vazio = usa CORS_ORIGIN.
APP_PUBLIC_URL=

# --- Banco (MySQL/MariaDB via MikroORM @mikro-orm/mysql) ---
# Ex.: mysql://emdr:emdr@localhost:3306/emdr
DATABASE_URL=

# --- Auth (JWT próprio — sem terceiros de identidade) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Vídeo (Daily.co) ---
DAILY_CO_API_KEY=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- E-mail (nodemailer/SMTP — convites, reset de senha, verificação) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@emdrremoto.com.br

# --- Redis (opcional; ligar só na Fase 6 se houver >1 réplica / presença / filas) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=https://evo2.techbs.com.br
EVOLUTION_API_KEY=            # chave GLOBAL do Evolution (só p/ criar instância própria via QR)
EVOLUTION_SHARED_INSTANCE=    # instância compartilhada existente (ex.: emdr)
EVOLUTION_SHARED_APIKEY=      # apikey da instância compartilhada

# --- Error Reporter (port de monitoramento; vazio = no-op) ---
ERROR_REPORTER_URL=
ERROR_REPORTER_API_KEY=
