{
  "name": "@veertex/backend",
  "version": "1.0.0",
  "description": "Backend do Veertex — ERP SaaS multi-tenant (hexagonal, NestJS + Fastify + MikroORM/PostgreSQL self-hosted)",
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "NODE_ENV=production node dist/main",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migrate:prod": "node dist/infrastructure/persistence/mikro-orm/migrate",
    "verify:isolation": "ts-node -P tsconfig.json src/infrastructure/persistence/mikro-orm/verify-isolation.ts",
    "verify:isolation:prod": "node dist/infrastructure/persistence/mikro-orm/verify-isolation",
    "verify:rls": "ts-node -P tsconfig.json src/infrastructure/persistence/mikro-orm/verify-rls.ts",
    "verify:rls:prod": "node dist/infrastructure/persistence/mikro-orm/verify-rls",
    "create:account": "ts-node -P tsconfig.json src/infrastructure/persistence/mikro-orm/create-account.cli.ts",
    "create:account:prod": "node dist/infrastructure/persistence/mikro-orm/create-account.cli",
    "seed:dev": "ts-node -P tsconfig.json src/infrastructure/persistence/mikro-orm/seed-dev.cli.ts",
    "seed:dev:prod": "node dist/infrastructure/persistence/mikro-orm/seed-dev.cli",
    "smoke:auth": "ts-node -P tsconfig.json src/infrastructure/persistence/mikro-orm/smoke-auth.ts",
    "smoke:auth:prod": "node dist/infrastructure/persistence/mikro-orm/smoke-auth",
    "test:integration": "jest --testPathPattern=test/integration --runInBand"
  },
  "dependencies": {
    "@veertex/domain-primitives": "^1.0.0",
    "@veertex/shared-kernel": "^1.0.0",
    "@mikro-orm/core": "^6.2.0",
    "@mikro-orm/migrations": "^6.2.0",
    "@mikro-orm/nestjs": "^6.0.0",
    "@mikro-orm/postgresql": "^6.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/platform-fastify": "^10.3.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.5",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
